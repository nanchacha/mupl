# Google Drive API 인증 정보 (Service Account 권장)
# 1. Google Cloud Console에서 Service Account 생성 및 키 발급
# 2. 업로드하려는 Google Drive 폴더를 Service Account 이메일 주소로 공유(편집자 권한)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account-email@your-project-id.iam.gserviceaccount.com"
# PRIVATE_KEY는 줄바꿈(\n)을 포함한 전체 문자열을 따옴표 안에 넣어야 합니다.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# 유튜브에서 추출한 MP3를 저장할 구글 드라이브 폴더 ID
# (URL의 folders/ 뒤에 있는 문자열)
GOOGLE_DRIVE_FOLDER_ID="1SS9kZ16KErhHA-QMZmMm_QsO8aqS7O9C"

# (옵션) 유튜브 봇 탐지 에러 (Sign in to confirm you're not a bot) 우회를 위한 쿠키
# 크롬 확장프로그램 "EditThisCookie" 등을 이용해 유튜브 쿠키를 JSON 배열 형태로 복사하여 아래에 붙여넣으세요.
YOUTUBE_COOKIES='[{"domain":".youtube.com","name":"__Secure-1PSID","value":"..."}, ...]'

